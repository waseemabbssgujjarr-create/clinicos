            name: c.name,
            bookingSlug: c.bookingSlug,
            slug: c.bookingSlug,
            specialty: c.specialty,
            address: c.address,
            city: extractCity(c.address),
            phone: c.phone,
            logoUrl: c.logoUrl,
            doctorCount: providerCount,
            ownerName: c.ownerName,
            availabilityLabel: availability.label,
            availabilityStatus: availability.status,
        };
    }));
    res.json({ count: mapped.length, clinics: mapped });
}));
// ─── GET /api/public/clinics/:slug — clinic detail + doctors ────────────────
router.get('/clinics/:slug', (0, asyncHandler_1.asyncHandler)(async (req, res) => {
    const clinic = await prisma_1.prisma.clinic.findUnique({
