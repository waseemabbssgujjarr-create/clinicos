                    { specialty: { contains: q } },
                    { address: { contains: q } },
                    { ownerName: { contains: q } },
                ],
            } : {}),
            ...(specialty ? { specialty: { contains: specialty } } : {}),
            ...(city ? { address: { contains: city } } : {}),
        }),
        select: {
            id: true,
            name: true,
            bookingSlug: true,
            specialty: true,
            address: true,
            phone: true,
            logoUrl: true,
            ownerName: true,
            workingHours: true,
            _count: { select: { staff: { where: { isActive: true, role: { in: ['NURSE', 'MANAGER'] } } } } },
        },
        orderBy: { name: 'asc' },
        take: 100,
    });
