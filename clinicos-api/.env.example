# ═══════════════════════════════════════════════════════════════════════════════
# Doctors My Agency — clinicos-api Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# On Hostinger: set these as environment variables in the Node.js app panel.
# NEVER commit .env to git — add it to .gitignore.
#
# ARCHITECTURE NOTE:
#   Global config (this file) — platform-wide settings.
#   Per-clinic WhatsApp credentials — stored encrypted in DB (ClinicWhatsAppConnection).
#   Do NOT add META_WABA_ID, META_PHONE_NUMBER_ID, or System User tokens here.
#   Those belong to individual clinic connections, entered via the dashboard.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=https://doctorsmyagency.com
FRONTEND_URL=https://doctorsmyagency.com
APP_NAME=Doctors My Agency
NODE_ENV=production
PORT=3001
TRIAL_DAYS=14

# ── Database (MySQL — Hostinger) ──────────────────────────────────────────────
# Use the exact host shown in Hostinger → MySQL Databases.
# Local dev uses 127.0.0.1; shared hosting may use a different hostname.
DATABASE_URL="mysql://USERNAME:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Email (SMTP) — Required for verification, password reset, staff invites ───
# Configure in Superadmin → Integrations (saved to DB) OR set here.
# DB values override .env at runtime so you can update without restarting.
SMTP_HOST=mail.doctorsmyagency.com
SMTP_PORT=465
SMTP_USER=info@doctorsmyagency.com
SMTP_PASS=
SMTP_FROM="Doctors My Agency <info@doctorsmyagency.com>"
SMTP_SECURE=true
# SMTP_DEBUG=1
# SKIP_SMTP_VERIFY=1

# ── AI Receptionist ───────────────────────────────────────────────────────────
# Required for the WhatsApp AI receptionist feature.
# Supports DeepSeek (recommended) or any OpenAI-compatible provider.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Alternative: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Meta WhatsApp (GLOBAL APP SETTINGS) ──────────────────────────────────────
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  IMPORTANT: These are PLATFORM-LEVEL credentials for the DMA Meta App.  ║
# ║  Per-clinic WABA ID, Phone Number ID, and System User tokens are stored  ║
# ║  encrypted in the database per clinic — NOT here as env vars.            ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# 1. Create a Meta App at https://developers.facebook.com/apps/
#    Type: Business | Product: WhatsApp
# 2. META_APP_ID = App Dashboard → Settings → Basic → App ID
# 3. META_APP_SECRET = App Dashboard → Settings → Basic → App Secret
# 4. META_WEBHOOK_VERIFY_TOKEN = any random string you choose;
#    must match exactly what you enter in Meta App → WhatsApp → Configuration
# 5. META_ENCRYPTION_KEY = random 32-byte hex (generate below);
#    used to encrypt per-clinic WhatsApp tokens at rest.
#    ⚠ NEVER rotate this key after clinics have connected — tokens become unreadable.
# 6. META_CONFIG_ID = Embedded Signup configuration ID from the approved DMA Meta App
#
# Generate META_ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Webhook URL to register in Meta:
#   https://doctorsmyagency.com/api/webhooks/meta
# Verify webhook is live:
#   https://doctorsmyagency.com/api/webhooks/meta?probe=1
#
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
META_ENCRYPTION_KEY=

# Embedded Signup Config ID — from the approved Doctors My Agency Meta App
META_CONFIG_ID=

# ── FEATURE FLAG: Embedded Signup ────────────────────────────────────────────
#
# Clinic dashboard uses Meta Embedded Signup only (doctors, not other businesses).
# Set true once App ID + Config ID from the approved Meta app are saved
# (Superadmin → Integrations or here).
#
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=true

# ── Twilio (SMS fallback — optional) ─────────────────────────────────────────
# Meta WhatsApp is the primary channel for all clinics.
# Twilio is used only as a fallback for SMS if configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=

# ── Stripe — Billing ──────────────────────────────────────────────────────────
# Required when trials convert to paid plans.
# Webhook: https://doctorsmyagency.com/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Cloudinary — Clinic logo uploads ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Internal bridge ───────────────────────────────────────────────────────────
# Shared secret for /api/internal/* endpoints.
# Required only if you use the internal bridge from another trusted service.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CLINICOS_BRIDGE_KEY=

# ── Google Places — Review requests ──────────────────────────────────────────
# Optional — clinics can also set their own Google Place ID in dashboard settings.
# GOOGLE_PLACES_API_KEY=

# ── Testing (development only) ────────────────────────────────────────────────
# Enables /api/whatsapp/test-connect and /api/whatsapp/test-inbound endpoints in production.
# Remove or leave blank in production unless needed for Meta App Review screencast.
# TEST_CONNECT_KEY=
