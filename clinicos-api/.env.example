# Doctors My Agency — clinicos-api environment
# Copy to .env and fill in values. On cPanel: edit clinicos-api/.env then restart Node.

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://clinicos.workee.online
FRONTEND_URL=https://clinicos.workee.online
APP_NAME=Doctors My Agency
NODE_ENV=production
PORT=3002
TRIAL_DAYS=14

# ── Database (MySQL via cPanel) ───────────────────────────────────────────────
# On same server, localhost is normal. If Node cannot connect (P1001),
# use the MySQL host shown in cPanel → MySQL Databases.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string-here

# ── Email (cPanel SMTP) — REQUIRED for verification / reset ──────────────────
# Prefer configuring these in Superadmin → Integrations (saved to DB).
# SMTP_PASS must belong to the SAME mailbox as SMTP_USER.
# Check logs/startup.log for "SMTP verify: OK" after restart.
SMTP_HOST=mail.workee.online
SMTP_PORT=465
SMTP_USER=support@clinicos.workee.online
SMTP_PASS="your-mailbox-password-here"
SMTP_FROM="Doctors My Agency <support@clinicos.workee.online>"
# Quote SMTP_PASS if it contains & # or spaces. Try port 587 if 465 fails.
# SMTP_DEBUG=1
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# ── AI — REQUIRED for receptionist ───────────────────────────────────────────
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Aliases also supported: DEEPSEEK_BASE_URL, DEEPSEEK_MODEL
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Twilio — SMS fallback / voice ─────────────────────────────────────────────
# Only needed if you use Twilio for SMS or as a WhatsApp fallback.
# Meta WhatsApp (below) is the primary channel for all new clinics.
# Webhook: POST {APP_URL}/api/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1XXXXXXXXXX

# ── Stripe — REQUIRED for paid plans after trial ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ── Cloudinary — clinic logo uploads ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Places — review requests (optional per clinic) ────────────────────
# Clinics can also set googlePlaceId + googleApiKey in dashboard settings.

# ══════════════════════════════════════════════════════════════════════════════
# META WHATSAPP — REQUIRED for every doctor's WhatsApp Business connection
# ══════════════════════════════════════════════════════════════════════════════
#
# SETUP CHECKLIST (do all of these before your first doctor connects):
#
# 1. Create a Meta App at https://developers.facebook.com/apps/
#    Type: Business | Add product: WhatsApp
#
# 2. Copy App ID → META_APP_ID
#    Copy App Secret → META_APP_SECRET
#    (Meta App Dashboard → Settings → Basic)
#
# 3. Create a WhatsApp Embedded Signup Config in
#    Meta App → WhatsApp → Embedded Signup → Create configuration
#    Copy Config ID → META_CONFIG_ID
#
# 4. Set META_WEBHOOK_VERIFY_TOKEN to any random string you choose,
#    then register the webhook in Meta App → WhatsApp → Configuration:
#      Callback URL : {APP_URL}/api/webhooks/meta
#      Verify token : (the value you set here)
#      Subscribed fields: messages
#
# 5. Under App → Settings → Basic → App Domains, add: clinicos.workee.online
#    Under Facebook Login → Settings → Valid OAuth Redirect URIs, add:
#      {APP_URL}/dashboard/settings/
#
# 6. Generate META_ENCRYPTION_KEY with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    NEVER change this key after doctors have connected — it will break all
#    stored tokens and every clinic will need to reconnect.
#
# 7. Set CLINICOS_BRIDGE_KEY to a shared secret (any random string) if you
#    use the /api/internal bridge from iqpigeon or another service. Leave
#    blank if the internal bridge is not used.
#
# Verify setup at: {APP_URL}/api/webhooks/meta?probe=1
# Expected response: { "ok": true, "connectedClinics": <n> }
#
# ─────────────────────────────────────────────────────────────────────────────

# Your Meta App ID (visible on Meta App Dashboard — 15 digits)
META_APP_ID=552479924130015

# Your Meta App Secret (Meta → Settings → Basic → App Secret → Show)
META_APP_SECRET=

# Embedded Signup Config ID (Meta → WhatsApp → Embedded Signup → your config)
META_CONFIG_ID=2328213571283480

# Graph API version — update when Meta deprecates older versions
META_GRAPH_API_VERSION=v21.0

# Webhook verify token — any random string; must match Meta App → WhatsApp → Configuration
META_WEBHOOK_VERIFY_TOKEN=

# AES-256 key used to encrypt stored access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Never rotate this key after clinics have connected.
META_ENCRYPTION_KEY=

# Internal bridge shared secret — must match on both sides if using the bridge
CLINICOS_BRIDGE_KEY=

# Optional — URL to the iqpigeon PHP advanced tools subfolder (broadcasts, etc.)
# WHATSAPP_PHP_URL=https://clinicos.workee.online/whatsapp/client/leads

# ── Testing (remove or leave blank in production if not needed) ───────────────
# Enables /api/whatsapp/test-connect and /api/whatsapp/test-inbound endpoints.
# Set to any random secret string. Pass as X-Test-Key header when calling.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TEST_CONNECT_KEY=

# ── Optional / future ─────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=
